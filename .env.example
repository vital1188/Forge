# EASYPOST_API_KEY: Your production EasyPost API key (starts with EZPT...)
EASYPOST_API_KEY=""

# EASYPOST_SUB_ACCOUNT_ID: The User ID of the sub-account (e.g., user_...)
EASYPOST_SUB_ACCOUNT_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
